# Hugging Face Spaces Environment Configuration (ZeroGPU / 16GB RAM)
# Copy these into Space Settings -> Variables and secrets

# --- Security Secrets (Space Secrets) ---
# Set strong random keys for your deployment
AUTH_KEY=
ENCRYPTION_KEY=

# Optional Bearer token to protect external access to Von decision endpoint
# (Local loopback requests from GPT-Load automatically bypass authentication)
VON_API_KEY=

# Optional Space restart credentials for automatic von-sdk updates
# HF_TOKEN=

# --- Hugging Face Storage Bucket Mount ---
# Directory where your HF Storage Bucket volume is mounted (default: /data)
HF_STORAGE_DIR=/data

# Fast local container disk used for working SQLite database with WAL performance
LOCAL_DATA_DIR=/tmp/gpt-load/data

# Frequency in seconds to create verified SQLite snapshots to the persistent bucket
DB_SYNC_INTERVAL_SECONDS=300

# --- Port Configuration ---
# Hugging Face Spaces listens on port 7860
PORT=7860
# Internal port for gpt-load engine
GPT_LOAD_INTERNAL_PORT=3001
# Dedicated internal loopback port for Von Decision Server
INTERNAL_VON_PORT=7861

# --- Memory & Concurrency Optimization (16GB RAM Available) ---
# Go memory constraints (GOMEMLIMIT, GOGC) are intentionally omitted to allow
# the Go runtime to scale dynamically across the 16GB available host memory.
# Unconstrained connection pool limits:
DATABASE_MAX_OPEN_CONNECTIONS=25
DATABASE_MAX_IDLE_CONNECTIONS=10

# --- Client IP Trust (Internal Ingress Proxy) ---
CLIENT_IP_HEADER=X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1

# --- Local Von Endpoints for GPT-Load Jev Channel ---
# Recommended Jev Base URL in GPT-Load:
#   http://127.0.0.1:7861/v1   (Dedicated loopback listener)
# Or path-based:
#   http://127.0.0.1:7860/von/v1

# --- Synthetic Models & Routing Rules (Space Variable) ---
SYNTHETIC_MODELS=[{"name":"gemini-flash-auto-frontier","description":"Gemini Flash frontier models priority","target_models":["gemini-flash-latest","gemini-3.8-flash","gemini-3.7-flash","gemini-3.5-flash","gemini-3.6-flash"]},{"name":"gemini-flash-auto-mid","description":"Gemini Flash mid tier models priority","target_models":["gemini-3.7-flash","gemini-3.5-flash","gemini-3.6-flash","gemini-3.8-flash","gemini-flash-latest"]},{"name":"gemini-flash-auto-low","description":"Gemini Flash low tier models priority","target_models":["gemini-3.6-flash","gemini-3.5-flash","gemini-3.7-flash","gemini-3.8-flash","gemini-flash-latest"]},{"name":"gemini-flash-auto-simple","description":"Gemini Flash Simple task models","target_models":["gemini-flash-lite-latest","gemini-3.6-flash","gemini-3.5-flash","gemini-3.7-flash","gemini-3.8-flash","gemini-flash-latest"]}]
